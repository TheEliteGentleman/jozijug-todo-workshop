<?xml version="1.0" encoding="UTF-8"?>
<!-- Open Liberty: copy to usr/servers/defaultServer/server.xml,
     copy target/todo.war to usr/servers/defaultServer/apps/ -->
<server description="Todo workshop">
    <featureManager>
        <feature>webProfile-11.0</feature>
        <feature>mpOpenAPI-4.1</feature>
    </featureManager>

    <httpEndpoint id="defaultHttpEndpoint" host="*" httpPort="9080" httpsPort="9443"/>
    
    <!-- Point a library to the H2 jar inside your deployed app -->
    <library id="H2Lib">
        <fileset dir="${server.config.dir}/lib/jdbc" includes="h2*.jar"/>
    </library>

    <webApplication location="${project.name}.war" contextRoot="/${project.name}">
    	<classloader commonLibraryRef="H2Lib"/>
    </webApplication>
    
    <!-- Configure the DataSource -->
    <!-- This is how you should be doing it...
    <dataSource id="H2DataSource" jndiName="jdbc/TodoDS" type="javax.sql.DataSource">
        <jdbcDriver libraryRef="H2Lib" javax.sql.DataSource="org.h2.jdbcx.JdbcDataSource"/>
        <properties URL="jdbc:h2:mem:todo;DB_CLOSE_DELAY=-1" user="sa" password=""/>
    </dataSource>
    -->
    
    <cors domain="/api"
        allowedOrigins="*"
        allowedMethods="GET, POST, PUT, DELETE, OPTIONS, HEAD"
        allowCredentials="true"
        allowedHeaders="origin, content-type, accept, authorization"
        maxAge="1209600"/>
</server>
